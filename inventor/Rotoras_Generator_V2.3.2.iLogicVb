' ============================================================

Try

    rotorasProps.Item( _
        "Rotoras_Diameters").Value = _
        rotorasDiametersTekst

Catch

    rotorasProps.Add( _
        rotorasDiametersTekst, _
        "Rotoras_Diameters")

End Try


