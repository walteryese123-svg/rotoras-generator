Try
    rotorasProps.Item("Rotoras_SpieBegin").Value = _
        rotorasSpieBeginTekst
Catch
    rotorasProps.Add( _
        rotorasSpieBeginTekst, _
        "Rotoras_SpieBegin")
End Try


Try
    rotorasProps.Item("Rotoras_SpieLengte").Value = _
