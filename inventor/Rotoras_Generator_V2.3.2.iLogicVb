    rotorasProps.Item( _
        "Rotoras_MaxDiameter").Value = _
        rotorasMaxDiameter

Catch

    rotorasProps.Add( _
        rotorasMaxDiameter, _
        "Rotoras_MaxDiameter")

End Try

Dim afEigenschapTekst As String = ""
For afI As Integer = 0 To afData.Count - 1
    If afI > 0 Then afEigenschapTekst &= ";"
    For afJ As Integer = 0 To 5
        If afJ > 0 Then afEigenschapTekst &= "|"
        afEigenschapTekst &= afData(afI)(afJ).ToString(System.Globalization.CultureInfo.InvariantCulture)
    Next
Next
Try
    rotorasProps.Item("Rotoras_AfschuiningData").Value = afEigenschapTekst
Catch
    rotorasProps.Add(afEigenschapTekst, "Rotoras_AfschuiningData")
End Try

' ============================================================
' 8. RESULTAAT
' ============================================================

oDoc.Update()

ThisApplication.ActiveView.Fit()



Dim totaleLengte As Double
totaleLengte = 0


Dim maxDiameter As Double
maxDiameter = 0



For i As Integer = 0 To lengtes.Count - 1


    totaleLengte += lengtes(i)


    If diameters(i) > maxDiameter Then
        maxDiameter = diameters(i)
    End If


Next



MessageBox.Show( _
    "Rotoras succesvol gegenereerd!" & _
    vbCrLf & vbCrLf & _
    "Versie: 2.3.2" & vbCrLf & _
    "Aantal secties: " & diameters.Count & vbCrLf & _
    "Totale lengte: " & totaleLengte & " mm" & vbCrLf & _
    "Grootste diameter: Ø" & maxDiameter & " mm", _
    "Rotoras Generator 2.3.2")

